<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1707: nomes de teste com "_"; CA1515/CA1062/CA1848/CA1873/CA2007: ruído em app web pequeno; CA1305/CA1307/CA1309/CA1310/CA1311: as comparações aqui são todas ordinais e explícitas -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1062;CA1848;CA1873;CA2007;CA1305;CA1307;CA1309;CA1310;CA1311;CA1716</NoWarn>
  </PropertyGroup>
</Project>
