# URL da API que o proxy protege (ex.: a API de Chamados). Vazia = modo demonstração, com uma API falsa embutida.
# UPSTREAM_URL=http://localhost:8080

# Token da administração (/_chaos/rules). Obrigatório em produção, mínimo 32 caracteres.
# Gere um com: openssl rand -hex 32   (no Render ele é gerado sozinho pelo render.yaml)
CHAOS_ADMIN_TOKEN=troque-por-um-token-aleatorio-de-32-ou-mais

# Requisições por minuto por cliente que o proxy aceita repassar (padrão 600).
# PROXY_RATE_LIMIT=600

# true só atrás de um balanceador que preenche o X-Forwarded-For (Render, Nginx...).
# TRUST_FORWARDED_HEADERS=false
